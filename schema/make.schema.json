{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MahAbdulKhaliq/voltway/schema/make.schema.json",
  "title": "Make",
  "description": "A brand (vehicle-data-model.md §2, §4). File: data/makes/<slug>.json",
  "type": "object",
  "required": ["id", "name"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "country": { "description": "ISO 3166-1 alpha-2 country of the brand.", "type": "string", "pattern": "^[A-Z]{2}$" }
  }
}
