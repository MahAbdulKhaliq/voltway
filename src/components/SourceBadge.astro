---
// The source badge (database-ui.md §7): a small label saying what kind of figure this is.
// Opening it shows the source, the date, other figures from other sources, and a
// "sources differ" note. Uses <details>, so it works without JavaScript.
import { t } from '../i18n/t.ts';
import { display, kindLabel } from '../lib/format.ts';
import type { Field, Source } from '../lib/types.ts';

interface Props {
  field: Field;
  sources: Source[];
  label: string; // what the figure is, for screen readers
}
const { field, sources, label } = Astro.props;
const src = (id: string) => sources.find((s) => s.id === id);
const main = field?.value;
const mainSource = main ? src(main.source_id) : undefined;
---

{main && (
  <details class:list={['badge', `kind-${main.kind}`, { low: main.low_confidence }]}>
    <summary aria-label={t('badge.open', { label })}>
      {kindLabel(main.kind)}
      {field!.conflict && <span class="differ" title={t('badge.differ')} aria-label={t('badge.differ')}>⚠</span>}
    </summary>
    <div class="pop">
      <p class="pop-title">{t('badge.source')}</p>
      {mainSource ? (
        <p><a href={mainSource.url} rel="noopener" target="_blank">{mainSource.title}</a><br /><span class="muted small">{t('badge.accessed', { date: mainSource.accessed_on })}</span></p>
      ) : <p class="muted">{main.source_id}</p>}
      {main.notes && <p class="small">{main.notes}</p>}
      {main.low_confidence && <p class="small"><strong>{t('badge.lowConfidence')}.</strong> {t('badge.lowConfidenceHelp')}</p>}
      {field!.conflict && <p class="small"><strong>⚠ {t('badge.differ')}.</strong> {t('badge.differHelp')}</p>}
      {field!.others.length > 0 && (
        <>
          <p class="pop-title">{t('badge.others')}</p>
          <ul>
            {field!.others.map((o) => {
              const s = src(o.source_id);
              const d = display(o);
              return <li><span {...d.attrs}>{d.text}</span> · {kindLabel(o.kind)}{s && <> · <a href={s.url} rel="noopener" target="_blank">{s.title}</a></>}</li>;
            })}
          </ul>
        </>
      )}
    </div>
  </details>
)}

<style>
  .badge { display: inline-block; position: relative; font-size: 0.75rem; vertical-align: middle; }
  .badge summary {
    list-style: none; cursor: pointer; display: inline-flex; gap: 4px; align-items: center;
    padding: 1px 8px; border-radius: 999px; border: 1px solid var(--border);
    background: var(--surface-2); color: var(--muted); white-space: nowrap;
  }
  .badge summary::-webkit-details-marker { display: none; }
  .badge.kind-rated_nrcan summary, .badge.kind-rated_epa summary { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, transparent); background: var(--accent-soft); }
  .badge.kind-estimated summary { color: var(--estimated); border-style: dashed; background: var(--estimated-soft); font-style: italic; }
  .badge.low summary { border-style: dotted; }
  .differ { color: var(--warn); }
  .pop {
    position: absolute; z-index: 5; top: calc(100% + 6px); left: 0; width: min(320px, 80vw);
    background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 10px;
    box-shadow: var(--shadow); padding: 12px; font-size: 0.875rem; line-height: 1.4;
  }
  .pop p { margin: 0 0 8px; }
  .pop ul { margin: 0; padding-left: 18px; }
  .pop-title { font-weight: 600; color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
</style>
