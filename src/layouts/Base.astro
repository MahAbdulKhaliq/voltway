---
// Page shell (B20, B65): on narrow screens a menu button (left) opens a side panel with the list of
// pages; wide screens list the pages in the header instead. Then the logo, My car and the Settings
// menu (theme, animations, km/mi); main content; footer. Trip joins
// PAGES as they're built. The map is the home page (B26). Distances render in km and are converted in place when the
// visitor picks miles (database-ui.md §9; the switch lives in the curve controls, B19).
// Archivo (text) and Overpass (display, B64: the road-sign face) are bundled with the build and
// served from this site (no third-party font request, DESIGN-4).
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/overpass/wght.css';
import '../styles/global.css';
import { t, type MessageKey } from '../i18n/t.ts';
import HeaderChips from '../components/HeaderChips.tsx';

type Page = 'map' | 'charging' | 'cars' | 'compare' | 'about';
// fill: the page is one full-screen tool (the map): no width limit and no footer; credits live in the tool.
interface Props { title?: string; description?: string; active?: Page; fill?: boolean }
const { title, description = t('site.tagline'), active, fill = false } = Astro.props;
const pageTitle = title ? `${title} · ${t('site.name')}` : t('site.name');
// Link preview (P.3): what LinkedIn, Slack and messaging apps show for a shared link.
// Links on the site have no trailing slash (/charging), so the canonical URL doesn't either.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isNotFound = path === '/404';
const pageUrl = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

// Pages in the header (wide screens) and the side menu (narrow screens).
const PAGES: { id: Page; href: string }[] = [
  { id: 'map', href: '/' },
  { id: 'charging', href: '/charging' },
  { id: 'cars', href: '/cars' },
  { id: 'compare', href: '/compare' },
  { id: 'about', href: '/about' },
];
const page = (id: Page, part: 'name' | 'desc') =>
  t((part === 'name' ? `nav.${id}` : `nav.${id}.${part}`) as MessageKey);
const short = (id: Page) => (id === 'map' || id === 'about' ? t(`nav.${id}.short`) : page(id, 'name'));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    {!isNotFound && <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!isNotFound && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.ogAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Apply a saved theme before first paint, so there is no flash of the wrong theme. -->
    <script is:inline>
      try {
        var saved = localStorage.getItem('voltway.theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
      // B65: Animations is a site setting (on by default), not the device's reduce-motion signal.
      try {
        if (localStorage.getItem('voltway.motion') === 'off') document.documentElement.dataset.motion = 'off';
      } catch (e) {}
      // B64: the mark's intro (it strikes in with a flash) plays once per visit, not on every page.
      try {
        if (document.documentElement.dataset.motion !== 'off' && !sessionStorage.getItem('voltway.intro')) {
          document.documentElement.classList.add('intro');
          sessionStorage.setItem('voltway.intro', '1');
        }
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class={fill ? "fill-page" : undefined}>
    <a class="skip" href="#main">{t('site.skip')}</a>
    <header class="site-header">
      <div class="wrap bar">
        <button type="button" class="icon-btn menu-btn" aria-haspopup="dialog" aria-controls="side-nav" aria-label={t('nav.menu')}>
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
        </button>
        <a class="logo" href="/">
          <!-- The mark (B118, owner 2026-11-20): a V whose right arm is a road that turns into a bolt
               (scripts/logo-assets.mjs). One file for both themes: its cream outline keeps the
               near-black V visible on the dark background (owner, 2026-11-20). On a visit's first
               page the mark strikes in with a flash of paint (html.intro, global.css). -->
          <img class="logo-mark" src="/logo.png" width="39" height="28" alt="" aria-hidden="true" />
          <span class="logo-word">{t('site.name')}</span>
        </a>
        <!-- The header is a small floating pill on every page (B54); on wide screens it also lists the pages. -->
        <nav class="pill-nav" aria-label={t('nav.quick')}>
          {PAGES.map((p) => (
            <a href={p.href} aria-current={active === p.id ? 'page' : undefined}>
              {p.id === 'compare' ? <span data-compare-name>{short(p.id)}</span> : short(p.id)}
            </a>
          ))}
        </nav>
        <!-- My car on every page (owner, 2026-11-18; replaces B68's map-only chip). The Compare count
             sits on the Compare link itself, "Compare (n)", instead of a separate chip. -->
        <HeaderChips client:idle />
        <!-- Settings (B65): theme, animations and distance units for the whole site. -->
        <div class="settings">
          <button type="button" class="icon-btn settings-btn" aria-expanded="false" aria-controls="settings-pop" aria-label={t('settings.open')}>
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.08 4.85L10.35 2.14L13.65 2.14L13.92 4.85A7.4 7.4 0 0 1 15.70 5.59L17.81 3.86L20.14 6.19L18.41 8.30A7.4 7.4 0 0 1 19.15 10.08L21.86 10.35L21.86 13.65L19.15 13.92A7.4 7.4 0 0 1 18.41 15.70L20.14 17.81L17.81 20.14L15.70 18.41A7.4 7.4 0 0 1 13.92 19.15L13.65 21.86L10.35 21.86L10.08 19.15A7.4 7.4 0 0 1 8.30 18.41L6.19 20.14L3.86 17.81L5.59 15.70A7.4 7.4 0 0 1 4.85 13.92L2.14 13.65L2.14 10.35L4.85 10.08A7.4 7.4 0 0 1 5.59 8.30L3.86 6.19L6.19 3.86L8.30 5.59A7.4 7.4 0 0 1 10.08 4.85Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /><circle cx="12" cy="12" r="3.1" fill="none" stroke="currentColor" stroke-width="1.7" /></svg>
          </button>
          <div id="settings-pop" class="settings-pop" role="group" aria-labelledby="settings-title" hidden>
            <p id="settings-title" class="settings-title">{t('settings.title')}</p>
            <!-- Owner 2026-11-20: two folds, General (open on first visit) and Trip settings; opening one
                 closes the other, and the menu remembers which was open. -->
            <div class="settings-group settings-group-first" role="group" aria-labelledby="settings-general">
              <button type="button" class="settings-fold" data-fold="general" aria-expanded="true" aria-controls="settings-general-body">
                <span class="settings-fold-text">
                  <span id="settings-general" class="settings-sub">{t('settings.general')}</span>
                  <span id="settings-general-sum" class="settings-fold-sum" hidden></span>
                </span>
                <span class="acc-chev" aria-hidden="true"></span>
              </button>
              <div id="settings-general-body" class="settings-trips">
            <div class="settings-row">
              <span id="settings-theme">{t('settings.theme')}</span>
              <div class="seg theme-seg" role="group" aria-labelledby="settings-theme">
                <button type="button" data-theme-choice="light" aria-pressed="false">{t('settings.themeLight')}</button>
                <button type="button" data-theme-choice="dark" aria-pressed="false">{t('settings.themeDark')}</button>
                <button type="button" data-theme-choice="system" aria-pressed="false">{t('settings.themeSystem')}</button>
              </div>
            </div>
            <div class="settings-row">
              <span id="settings-motion">{t('settings.motion')}</span>
              <div class="seg motion-seg" role="group" aria-labelledby="settings-motion">
                <button type="button" data-motion-choice="on" aria-pressed="true">{t('settings.motionOn')}</button>
                <button type="button" data-motion-choice="off" aria-pressed="false">{t('settings.motionOff')}</button>
              </div>
            </div>
            <!-- B123: Region sets both units (Canada = km + °C, US = mi + °F); pressed only while both match. -->
            <div class="settings-row">
              <span id="settings-region">{t('settings.region')}</span>
              <div class="seg region-seg" role="group" aria-labelledby="settings-region">
                <button type="button" data-region="ca" aria-pressed="false">{t('settings.regionCa')}</button>
                <button type="button" data-region="us" aria-pressed="false">{t('settings.regionUs')}</button>
              </div>
            </div>
            <div class="settings-row">
              <span id="settings-temp">{t('settings.temperature')}</span>
              <div class="seg temp-seg" role="group" aria-labelledby="settings-temp">
                <button type="button" data-temp="C" aria-pressed="false">{t('temp.unit.C')}</button>
                <button type="button" data-temp="F" aria-pressed="false">{t('temp.unit.F')}</button>
              </div>
            </div>
            <!-- Route options (B73) and Stay within the border (B74, B78; a real switch, on by default, B79). -->
              </div>
            </div>
            <!-- Owner 2026-11-20: Trip settings folds to its title and a summary line (closed by default),
                 and holds Distances and the charging price as well as the route switches. -->
            <div class="settings-group" role="group" aria-labelledby="settings-route">
              <button type="button" class="settings-fold" data-fold="trips" aria-expanded="false" aria-controls="settings-trips">
                <span class="settings-fold-text">
                  <span id="settings-route" class="settings-sub">{t('settings.route')}</span>
                  <span id="settings-trips-sum" class="settings-fold-sum"></span>
                </span>
                <span class="acc-chev" aria-hidden="true"></span>
              </button>
              <div id="settings-trips" class="settings-trips" hidden>
              <div class="settings-row">
                <span id="settings-units">{t('settings.units')}</span>
                <div class="units seg" role="group" aria-labelledby="settings-units">
                  <button type="button" data-unit="km" aria-pressed="true">{t('units.km')}</button>
                  <button type="button" data-unit="mi" aria-pressed="false">{t('units.mi')}</button>
                </div>
              </div>
              <div class="settings-row">
                <label for="settings-price">{t('settings.price')}</label>
                <span class="settings-money"><span aria-hidden="true">$</span><input id="settings-price" type="number" inputmode="decimal" min="0" step="0.01" aria-describedby="settings-price-help" /></span>
              </div>
              <p id="settings-price-help" class="settings-help">{t('settings.priceHelp')}</p>
              <button type="button" role="switch" aria-checked="false" class="settings-switch" data-avoid="avoidTolls"><span>{t('settings.avoidTolls')}</span><span class="switch" aria-hidden="true"></span></button>
              <button type="button" role="switch" aria-checked="false" class="settings-switch" data-avoid="avoidHighways"><span>{t('settings.avoidHighways')}</span><span class="switch" aria-hidden="true"></span></button>
              <button type="button" role="switch" aria-checked="true" class="settings-switch" data-border><span>{t('settings.inBorder')}</span><span class="switch" aria-hidden="true"></span></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <dialog id="side-nav" class="side-nav" aria-label={t('nav.main')}>
      <div class="side-top">
        <button type="button" class="icon-btn close-btn" aria-label={t('nav.close')}>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
      </div>
      <nav aria-label={t('nav.main')}>
        <ul id="page-list" class="page-list">
          {PAGES.map((p) => (
            <li>
              <a href={p.href} aria-current={active === p.id ? 'page' : undefined}>
                <span class="pl-name" data-compare-name={p.id === 'compare' ? '' : undefined}>{page(p.id, 'name')}</span>
                <span class="pl-desc">{page(p.id, 'desc')}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </dialog>

    <main id="main" class={fill ? 'fill' : 'wrap'}>
      <slot />
    </main>
    {!fill && <footer class="site-footer">
      <div class="wrap">
        <p>{t('footer.note')}</p>
        <p class="small">{t('footer.data')} <a href="/about#data">{t('footer.about')}</a></p>
      </div>
    </footer>}

    <script>
      import { applyUnits, currentUnit, setUnit } from '../scripts/units-client.ts';
      import { initBadges } from '../scripts/badges-client.ts';
      import { getCompare } from '../lib/my-car.ts';
      import { t } from '../i18n/t.ts';
      import { chooseTheme, themeChoice } from '../scripts/theme-client.ts';
      import { motionOn, setMotion } from '../scripts/motion-client.ts';
      import { chargePrice, PRICE_EVENT, setChargePrice } from '../lib/price.ts';
      import { routeOptions, ROUTE_OPTIONS_EVENT, setRouteOptions, type RouteOptions } from '../lib/route-options.ts';
      import { currentTempUnit, regionOf, setTempUnit, TEMP_UNIT_EVENT } from '../lib/temp-unit.ts';
      import { getItem, setItem, KEYS } from '../lib/storage.ts';
      initBadges();
      applyUnits(currentUnit());

      // "Compare (n)" on the Compare links while cars are waiting to be compared; plain "Compare" otherwise.
      const compareNames = [...document.querySelectorAll<HTMLElement>('[data-compare-name]')];
      const compareLabel = (n: number) => (n > 0 ? t('nav.compareCount', { count: n }) : t('nav.compare'));
      const showCompareCount = (n: number) => compareNames.forEach((el) => { el.textContent = compareLabel(n); });
      showCompareCount(getCompare().length);
      window.addEventListener('voltway:compare', (e) => showCompareCount((e as CustomEvent<string[]>).detail.length));
      window.addEventListener('storage', () => showCompareCount(getCompare().length));
      document.querySelectorAll<HTMLButtonElement>('.units button').forEach((b) =>
        b.addEventListener('click', () => setUnit(b.dataset.unit === 'mi' ? 'mi' : 'km')),
      );

      // Side nav (B20; narrow screens only, B65): a modal <dialog>, so focus stays inside and Escape closes it.
      const nav = document.getElementById('side-nav') as HTMLDialogElement;
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
      menuBtn.addEventListener('click', () => nav.showModal());
      nav.querySelector('.close-btn')!.addEventListener('click', () => nav.close());
      nav.addEventListener('click', (e) => { if (e.target === nav) nav.close(); }); // backdrop
      nav.addEventListener('close', () => menuBtn.focus());

      // Settings (B65): a small panel under the gear. Escape or a click elsewhere closes it.
      const setBtn = document.querySelector<HTMLButtonElement>('.settings-btn')!;
      const pop = document.getElementById('settings-pop') as HTMLDivElement;
      const showPop = (open: boolean, refocus = false) => {
        pop.hidden = !open;
        setBtn.setAttribute('aria-expanded', String(open));
        // The pressed choice in the open fold, else the first fold's button.
        if (open) [...pop.querySelectorAll<HTMLButtonElement>('[aria-pressed=true], .settings-fold')].find((b) => b.offsetParent !== null)?.focus();
        else if (refocus) setBtn.focus();
      };
      setBtn.addEventListener('click', () => showPop(setBtn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('click', (e) => { if (!pop.hidden && !(e.target as Element).closest('.settings')) showPop(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pop.hidden) { e.preventDefault(); showPop(false, true); } }); // preventDefault: the trip planner leaves on an unclaimed Escape
      pop.addEventListener('focusout', (e) => {
        if (!pop.hidden && e.relatedTarget && !(e.relatedTarget as Element).closest('.settings')) showPop(false);
      });
      const press = (sel: string, attr: string, value: string) =>
        pop.querySelectorAll<HTMLButtonElement>(sel).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === value)));
      const syncTheme = () => press('[data-theme-choice]', 'data-theme-choice', themeChoice());
      const syncMotion = () => press('[data-motion-choice]', 'data-motion-choice', motionOn() ? 'on' : 'off');
      pop.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((b) =>
        b.addEventListener('click', () => { chooseTheme(b.dataset.themeChoice as 'light' | 'dark' | 'system'); syncTheme(); }),
      );
      pop.querySelectorAll<HTMLButtonElement>('[data-motion-choice]').forEach((b) =>
        b.addEventListener('click', () => { setMotion(b.dataset.motionChoice === 'on'); syncMotion(); }),
      );
      syncTheme();
      syncMotion();
      // Two folds (owner 2026-11-20): General (open on a first visit) and Trip settings. One open at a
      // time (or none); a closed fold shows a summary line. Remembered in the browser.
      type Fold = 'general' | 'trips' | 'none';
      const folds = {
        general: { btn: pop.querySelector<HTMLButtonElement>('[data-fold="general"]')!, body: document.getElementById('settings-general-body')!, sum: document.getElementById('settings-general-sum')! },
        trips: { btn: pop.querySelector<HTMLButtonElement>('[data-fold="trips"]')!, body: document.getElementById('settings-trips')!, sum: document.getElementById('settings-trips-sum')! },
      };
      const setFold = (which: Fold, remember = true) => {
        for (const [k, f] of Object.entries(folds)) {
          const open = k === which;
          f.btn.setAttribute('aria-expanded', String(open));
          f.body.hidden = !open;
          f.sum.hidden = open;
        }
        if (remember) setItem(KEYS.settingsFold, which);
      };
      const saved = getItem(KEYS.settingsFold);
      setFold(saved === 'trips' || saved === 'none' ? saved : 'general', false);
      for (const [k, f] of Object.entries(folds)) {
        f.btn.addEventListener('click', () => setFold(f.btn.getAttribute('aria-expanded') === 'true' ? 'none' : (k as Fold)));
      }
      const openTrips = (open: boolean) => setFold(open ? 'trips' : 'general');
      const tripsSum = folds.trips.sum;
      const syncGeneralSum = () => {
        const theme = themeChoice();
        const temp = currentTempUnit();
        const region = regionOf(currentUnit(), temp);
        folds.general.sum.textContent = t('settings.generalSum', {
          theme: t(theme === 'light' ? 'settings.sumThemeLight' : theme === 'dark' ? 'settings.sumThemeDark' : 'settings.sumThemeSystem'),
          motion: t(motionOn() ? 'settings.sumMotionOn' : 'settings.sumMotionOff'),
          region: region ? t(region === 'us' ? 'settings.regionUs' : 'settings.regionCa') : t('settings.sumRegionMixed'),
          temp: t(temp === 'F' ? 'temp.unit.F' : 'temp.unit.C'),
        });
      };
      for (const ev of [TEMP_UNIT_EVENT, 'voltway:units', 'storage']) window.addEventListener(ev, syncGeneralSum);
      // Theme and Animations change through their own buttons: refresh after any click in the menu.
      pop.addEventListener('click', () => setTimeout(syncGeneralSum, 0));
      syncGeneralSum();
      const syncTripsSum = () => {
        const o = routeOptions();
        const route = o.avoidTolls && o.avoidHighways ? t('route.avoid.both') : o.avoidTolls ? t('route.avoid.tolls') : o.avoidHighways ? t('route.avoid.highways') : t('trip.routeFastest');
        tripsSum.textContent = t('settings.tripsSum', {
          unit: t(currentUnit() === 'mi' ? 'units.mi' : 'units.km'),
          price: chargePrice().toFixed(2),
          route,
          border: o.crossBorder ? t('trip.routeCross') : t('trip.routeStay'),
        });
      };
      for (const ev of [ROUTE_OPTIONS_EVENT, PRICE_EVENT, 'voltway:units', 'storage']) window.addEventListener(ev, syncTripsSum);
      syncTripsSum();
      // "Change cost estimate" in a trip opens Settings at the price (after the click that sent it).
      window.addEventListener('voltway:settings', (e) => setTimeout(() => {
        showPop(true);
        const at = (e as CustomEvent<string>).detail;
        if (at === 'price' || at === 'route' || at === 'border') openTrips(true);
        if (at === 'price') document.getElementById('settings-price')?.focus();
        if (at === 'route') pop.querySelector<HTMLButtonElement>('[data-avoid]')?.focus();
        if (at === 'border') pop.querySelector<HTMLButtonElement>('[data-border]')?.focus();
      }));
      // Charging price (B66): kept when it's a number of zero or more; anything else snaps back.
      const priceIn = document.getElementById('settings-price') as HTMLInputElement;
      const showPrice = (v: number) => { priceIn.value = v.toFixed(2); };
      showPrice(chargePrice());
      priceIn.addEventListener('input', () => {
        const v = Number(priceIn.value);
        if (priceIn.value.trim() !== '' && Number.isFinite(v) && v >= 0) setChargePrice(v);
      });
      priceIn.addEventListener('change', () => showPrice(chargePrice()));
      window.addEventListener(PRICE_EVENT, () => { if (document.activeElement !== priceIn) showPrice(chargePrice()); });
      // Route options (B73): switches saved in the browser; the trip planner listens for the event.
      const avoidBtns = pop.querySelectorAll<HTMLButtonElement>('[data-avoid]');
      // Stay within the border (B79) is the opposite of the stored crossBorder: off until turned on (B80).
      const borderBtn = pop.querySelector<HTMLButtonElement>('[data-border]');
      const syncAvoid = () => {
        const o = routeOptions();
        avoidBtns.forEach((b) => b.setAttribute('aria-checked', String(o[b.dataset.avoid as keyof RouteOptions])));
        borderBtn?.setAttribute('aria-checked', String(!o.crossBorder));
      };
      borderBtn?.addEventListener('click', () => {
        const o = routeOptions();
        setRouteOptions({ ...o, crossBorder: !o.crossBorder });
      });
      avoidBtns.forEach((b) => b.addEventListener('click', () => {
        const o = routeOptions();
        const k = b.dataset.avoid as keyof RouteOptions;
        setRouteOptions({ ...o, [k]: !o[k] });
      }));
      window.addEventListener(ROUTE_OPTIONS_EVENT, syncAvoid);
      syncAvoid();
      // B123: Temperature (°C | °F) and the Region preset that sets both units.
      const syncUnits = () => {
        const temp = currentTempUnit();
        press('[data-temp]', 'data-temp', temp);
        press('[data-region]', 'data-region', regionOf(currentUnit(), temp) ?? '');
      };
      pop.querySelectorAll<HTMLButtonElement>('[data-temp]').forEach((b) =>
        b.addEventListener('click', () => setTempUnit(b.dataset.temp === 'F' ? 'F' : 'C')),
      );
      pop.querySelectorAll<HTMLButtonElement>('[data-region]').forEach((b) =>
        b.addEventListener('click', () => {
          const us = b.dataset.region === 'us';
          setUnit(us ? 'mi' : 'km');
          setTempUnit(us ? 'F' : 'C');
        }),
      );
      window.addEventListener(TEMP_UNIT_EVENT, syncUnits);
      window.addEventListener('voltway:units', syncUnits);
      window.addEventListener('storage', syncUnits);
      syncUnits();
    </script>
  </body>
</html>

<style>
  /* The header is a floating pill, top right, on every page (DESIGN-4 4.6, B54). On the map it
     floats over the map; on other pages it stays in view as the page scrolls. */
  .site-header {
    position: sticky; top: 12px; z-index: 20; width: fit-content; max-width: calc(100% - 24px); margin: 12px 12px 0 auto;
    background: var(--surface); border: 1px solid var(--border); border-radius: 999px; box-shadow: var(--shadow);
  }
  :global(body.fill-page) .site-header { position: absolute; top: 12px; right: 12px; left: auto; margin: 0; }
  .bar { display: flex; align-items: center; max-width: none; margin: 0; min-height: 48px; padding: 0 6px 0 2px; gap: 6px; }
  .logo { margin-right: 6px; }
