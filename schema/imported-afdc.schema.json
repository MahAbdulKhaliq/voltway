{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MahAbdulKhaliq/voltway/schema/imported-afdc.schema.json",
  "title": "Imported AFDC charging stations (Canada)",
  "description": "Written by scripts/import-afdc.ts from the daily AFDC pull. Public Level 2 / Level 3 stations only; facts only (ports with source level, plug, rated kW and count). Bands are derived at build time. Files: data/imported/afdc/<country>.json (ca, us)",
  "type": "object",
  "required": ["source", "source_id", "fetched_at", "raw_sha256", "raw_count", "dropped", "ignored_ports", "stations"],
  "additionalProperties": false,
  "properties": {
    "source": { "enum": ["afdc-ca", "afdc-us"] },
    "source_id": { "$ref": "common.schema.json#/$defs/sourceId" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "raw_count": { "type": "integer", "minimum": 0 },
    "dropped": {
      "type": "object",
      "required": ["private", "planned", "no_location", "no_l2_l3_ports"],
      "additionalProperties": false,
      "properties": {
        "private": { "type": "integer", "minimum": 0 },
        "planned": { "type": "integer", "minimum": 0 },
        "no_location": { "type": "integer", "minimum": 0 },
        "no_l2_l3_ports": { "type": "integer", "minimum": 0 }
      }
    },
    "ignored_ports": {
      "description": "Port counts by connector type outside the four plugs (e.g. NEMA outlets).",
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "name", "street", "city", "province", "postal", "lat", "lon", "network", "status",
          "expected_date", "restricted", "access_detail", "hours", "pricing", "pricing_fr", "updated", "confirmed", "ports"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "street": { "type": ["string", "null"] },
          "city": { "type": ["string", "null"] },
          "province": { "type": ["string", "null"] },
          "postal": { "type": ["string", "null"] },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "network": { "type": ["string", "null"] },
          "status": { "enum": ["E", "T"] },
          "expected_date": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date" }] },
          "restricted": { "type": "boolean" },
          "access_detail": { "type": ["string", "null"] },
          "hours": { "type": ["string", "null"] },
          "pricing": { "type": ["string", "null"] },
          "pricing_fr": { "type": ["string", "null"] },
          "updated": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date" }] },
          "confirmed": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date" }] },
          "ports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["level", "plug", "kw", "count"],
              "additionalProperties": false,
              "properties": {
                "level": { "enum": [2, 3] },
                "plug": { "enum": ["j1772", "ccs1", "nacs", "chademo"] },
                "kw": { "anyOf": [{ "type": "null" }, { "type": "number", "exclusiveMinimum": 0 }] },
                "count": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
