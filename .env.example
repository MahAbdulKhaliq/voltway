# Copy to .env and fill in. .env is gitignored; never commit real keys.
# NLR (AFDC) charger data API key, for npm run fetch:afdc (developer.nlr.gov).
NLR_API_KEY=
# openrouteservice key for the trip planner function (account.heigit.org). Also set in Vercel.
ORS_API_KEY=
# Open Charge Map API key, for npm run fetch:ocm (openchargemap.org > My profile > My apps).
OCM_API_KEY=
