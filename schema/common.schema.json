{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MahAbdulKhaliq/voltway/schema/common.schema.json",
  "title": "Shared definitions",
  "description": "Sourced values (vehicle-data-model.md §3): every figure is value + unit + kind + source. A field is either the string \"unknown\" or a list of one or more sourced values of different kinds. Each field_<unit> fixes the unit; a bare number fails both branches.",
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "sourceId": { "type": "string", "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "format": "date" },

    "kind": {
      "description": "What sort of number it is (§3). Badges: Official (Canada), Official (US), WLTP, Manufacturer, Tested, Community, Estimated.",
      "enum": ["rated_nrcan", "rated_epa", "rated_wltp", "manufacturer", "tested", "community", "estimated"]
    },

    "sourcedBase": {
      "type": "object",
      "required": ["kind", "source_id"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "source_id": { "$ref": "#/$defs/sourceId" },
        "notes": { "type": "string", "minLength": 1 },
        "low_confidence": {
          "description": "Set when the source is weak, e.g. its URL is only a homepage (§3 rule).",
          "type": "boolean"
        }
      }
    },

    "sourcedNumber": {
      "allOf": [{ "$ref": "#/$defs/sourcedBase" }],
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" },
        "kind": true, "source_id": true, "notes": true, "low_confidence": true
      },
      "additionalProperties": false
    },

    "sourcedFact": {
      "description": "A sourced categorical fact (heat pump, port, chemistry...). Same shape as a number, without a unit.",
      "allOf": [{ "$ref": "#/$defs/sourcedBase" }],
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": "string" },
        "kind": true, "source_id": true, "notes": true, "low_confidence": true
      },
      "additionalProperties": false
    },

    "unknown": { "const": "unknown" },

    "field_km": {
      "oneOf": [
        { "$ref": "#/$defs/unknown" },
        { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/sourcedNumber" }, { "type": "object", "properties": { "unit": { "const": "km" } } }] } }
      ]
    },
    "field_kwh": {
      "oneOf": [
        { "$ref": "#/$defs/unknown" },
        { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/sourcedNumber" }, { "type": "object", "properties": { "unit": { "const": "kWh" } } }] } }
      ]
    },
    "field_kw": {
      "oneOf": [
        { "$ref": "#/$defs/unknown" },
        { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/sourcedNumber" }, { "type": "object", "properties": { "unit": { "const": "kW" } } }] } }
      ]
    },
    "field_wh_per_km": {
      "oneOf": [
        { "$ref": "#/$defs/unknown" },
        { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/sourcedNumber" }, { "type": "object", "properties": { "unit": { "const": "Wh/km" } } }] } }
      ]
    },
    "field_hours": {
      "oneOf": [
        { "$ref": "#/$defs/unknown" },
        { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/sourcedNumber" }, { "type": "object", "properties": { "unit": { "const": "h" } } }] } }
      ]
    },
    "field_minutes": {
      "oneOf": [
        { "$ref": "#/$defs/unknown" },
        { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/sourcedNumber" }, { "type": "object", "properties": { "unit": { "const": "min" } } }] } }
      ]
    },
    "field_kg": {
      "oneOf": [
        { "$ref": "#/$defs/unknown" },
        { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/sourcedNumber" }, { "type": "object", "properties": { "unit": { "const": "kg" } } }] } }
      ]
    },
    "field_cad": {
      "oneOf": [
        { "$ref": "#/$defs/unknown" },
        { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/sourcedNumber" }, { "type": "object", "properties": { "unit": { "const": "CAD" } } }] } }
      ]
    }
  }
}
