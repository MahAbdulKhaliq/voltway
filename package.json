{
  "name": "voltway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EV specs and charging curves, with a source on every figure.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "fetch:nrcan": "tsx scripts/fetch-nrcan.ts",
    "import:nrcan": "tsx scripts/import-nrcan.ts",
    "fetch:openev": "tsx scripts/fetch-openev.ts",
    "import:openev": "tsx scripts/import-openev.ts",
    "fetch:chargeprice": "tsx scripts/fetch-chargeprice.ts",
    "fetch:afdc": "tsx scripts/fetch-afdc.ts",
    "import:afdc": "tsx scripts/import-afdc.ts",
    "import:chargeprice": "tsx scripts/import-chargeprice.ts",
    "fetch:geonames": "tsx scripts/fetch-geonames.ts",
    "fetch:canada": "tsx scripts/fetch-canada-outline.ts",
    "data:import": "npm run import:nrcan && npm run import:openev && npm run import:chargeprice",
    "suggest:matches": "tsx scripts/suggest-matches.ts",
    "gaps": "tsx scripts/gap-report.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "calibrate:highway": "tsx scripts/calibrate-highway.ts",
    "validate": "tsx scripts/validate.ts",
    "data:build": "tsx scripts/build-data.ts",
    "prebuild": "npm run validate && npm run data:build",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "astro check",
    "predev": "npm run data:build"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/vercel": "^11.0.22",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/overpass": "^5.3.0",
    "astro": "^7.4.12",
    "echarts": "^6.1.0",
    "maplibre-gl": "^5.24.1",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
