---
// The trip planner (Phase 3, route-planner.md). The page is static; the planner island calls
// /api/route (a Vercel Function) once per trip and plans the stops in the browser.
import Base from '../layouts/Base.astro';
import TripPlanner from '../components/TripPlanner.tsx';
import { t } from '../i18n/t.ts';
import { loadIndex } from '../lib/data.ts';

const index = loadIndex();
---
<Base title={t('trip.title')} description={t('nav.trip.desc')} active="trip">
  <h1 class="tp-title">{t('trip.title')}</h1>
  <p class="muted tp-intro">{t('trip.intro')}</p>
  <TripPlanner client:load cars={index} />
  <noscript><p class="banner">{t('trip.noJs')}</p></noscript>
</Base>
<style>
  .tp-title { margin: 0 0 4px; }
  .tp-intro { margin: 0 0 16px; max-width: 70ch; }
</style>
