---
// Not found (QA 3.15, QT2): a prerendered 404 so unknown paths are served as static files
// instead of running the server function.
import Base from '../layouts/Base.astro';
import { t } from '../i18n/t.ts';
---

<Base title={t('notFound.title')}>
  <h1>{t('notFound.title')}</h1>
  <p>{t('notFound.body')}</p>
  <p><a href="/">{t('notFound.home')}</a></p>
</Base>
