# dependencies
node_modules/

# Astro build output and cache
dist/
.astro/

# generated data (rebuilt by `npm run data:build`)
public/data/

# Vercel CLI local link
.vercel/

# env files (never commit secrets)
.env
.env.*
!.env.example

# logs and OS junk
npm-debug.log*
*.log
.DS_Store
Thumbs.db

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# Charger raw pulls (AFDC ~50 MB for Canada, more for the US; OCM) and the import summaries, per
# country (DESIGN-7 D1); only each FETCHED.json is committed
sources/afdc-*/stations-raw.json
sources/afdc-*/stations-raw.json.part
sources/afdc-*/summary.md
sources/ocm-*/poi-raw.json
sources/ocm-*/summary.md
sources/ocm-*/referencedata.json
