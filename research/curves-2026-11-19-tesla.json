{
  "sources": [
    {
      "id": "src-fastned-tesla-curves-2026",
      "type": "testing_org",
      "title": "Fastned: Tesla charge curves (Model 3 Long Range 2019-2023, Standard Range 2020-2023, Model Y Long Range 2022-2025)",
      "url": "https://www.fastnedcharging.com/en/brands-overview/tesla",
      "accessed_on": "2026-11-19",
      "notes": "Fastned publishes per-car charge curves measured on its own European CCS2 network (300 kW chargers); the numbers are embedded in the page (kW at each whole SoC %). Page says curves show behaviour with a battery at about 30 C; colder/warmer packs charge slower. CCS2, not Tesla Supercharger, so peak can be capped below the car's Supercharger peak. No reuse terms found on the site (robots.txt allows crawling; terms-conditions cover customers/app only); owner to confirm."
    }
  ],
