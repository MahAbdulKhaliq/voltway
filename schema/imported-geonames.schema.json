{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MahAbdulKhaliq/voltway/schema/imported-geonames.schema.json",
  "title": "Imported GeoNames places (Canada or US)",
  "description": "Written by scripts/fetch-geonames.ts from the GeoNames CA.zip or US.zip dump (B45, B78; data-sources.md §5a): current populated places in one country at or above its population floor (Canada 1,000, US 2,000), for From/To suggestions on the trip planner. The data build turns them into public/data/places-<cc>.json. Files: data/imported/geonames/places-ca.json, places-us.json",
  "type": "object",
  "required": [
    "source",
    "source_id",
    "url",
    "fetched_at",
    "zip_sha256",
    "min_population",
    "places"
  ],
  "additionalProperties": false,
  "properties": {
    "source": {
      "enum": [
        "geonames-ca",
        "geonames-us"
      ]
    },
    "source_id": {
      "$ref": "common.schema.json#/$defs/sourceId"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "zip_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "min_population": {
      "enum": [
        1000,
        2000
      ]
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ascii_name",
          "province",
          "lat",
          "lon",
          "population"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "GeoNames id.",
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "description": "Name as GeoNames spells it, accents kept (Montréal).",
            "type": "string",
            "minLength": 1
          },
          "ascii_name": {
            "type": "string",
            "minLength": 1
          },
          "province": {
            "description": "Province or territory (Canada) or state / DC (US) abbreviation; checked per country in validate-data.",
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "lat": {
            "description": "Canada or the US (Hawaii to Alaska).",
            "type": "number",
            "minimum": 18,
            "maximum": 84
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": -52
          },
          "population": {
            "type": "integer",
            "minimum": 1000
          }
        }
      }
    }
  }
}
