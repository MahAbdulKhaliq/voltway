---
// Old per-variant car pages now redirect into the Charging tab (decision B11),
// so earlier shared links keep working.
import { t } from '../../i18n/t.ts';
import { loadIndex } from '../../lib/data.ts';

export function getStaticPaths() {
  return loadIndex().map((e) => ({ params: { id: e.id } }));
}
const { id } = Astro.params as { id: string };
const target = `/charging?car=${id}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>{t('site.name')}</title>
  </head>
  <body>
    <p>{t('charging.redirecting')} <a href={target}>{t('charging.openInCharging')}</a></p>
  </body>
</html>
