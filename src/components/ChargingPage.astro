---
// The Charging tab (B11). Used by both / (home) and /charging.
import Base from '../layouts/Base.astro';
import CarExplorer from './CarExplorer.tsx';
import { t } from '../i18n/t.ts';
import { loadEstimates, loadIndex } from '../lib/data.ts';
import { COVERAGE } from '../config.ts';

const index = loadIndex();
const { wheel } = loadEstimates();
---
<Base title={t('charging.title')} active="charging">
  <p class="muted intro">{t('charging.intro')} <span class="small">{t('scope.short', { market: COVERAGE.market, regulator: COVERAGE.regulatorShort })}</span></p>
  <CarExplorer client:load index={index} wheelEffect={wheel} />
  <noscript><p class="banner">{t('charging.noJs')} <a href="/cars">{t('nav.cars')}</a></p></noscript>
</Base>
<style>
  .intro { margin: 0 0 16px; }
</style>
