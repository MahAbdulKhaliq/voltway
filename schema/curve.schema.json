{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MahAbdulKhaliq/voltway/schema/curve.schema.json",
  "title": "Charging curve",
  "description": "SoC → kW points for one variant under stated conditions (vehicle-data-model.md §5). Points must be sorted by SoC (checked by the validator). Estimated curves are generated by the data build, not stored here. File: data/curves/<make>/<model>/<year>/<variant>/<curve>.json",
  "type": "object",
  "required": ["id", "variant_id", "kind", "source_id", "points", "is_display_default"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "variant_id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+/[0-9]{4}/[a-z0-9-]+$" },
    "kind": { "description": "Curves are measured or published; estimates are generated at build.", "enum": ["tested", "community", "manufacturer"] },
    "source_id": { "$ref": "common.schema.json#/$defs/sourceId" },
    "low_confidence": { "type": "boolean" },
    "points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["soc_percent", "power_kw"],
        "additionalProperties": false,
        "properties": {
          "soc_percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "power_kw": { "type": "number", "minimum": 0, "maximum": 1500 }
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preconditioned": { "enum": ["yes", "no", "unknown"] },
        "battery_temp_c": { "type": "number" },
        "ambient_temp_c": { "type": "number" },
        "charger_kw": { "type": "number", "minimum": 0 },
        "charger_max_voltage_v": { "type": "number", "minimum": 0 },
        "measured_at": { "description": "Whether power was measured at the charger or at the battery (C9 import note).", "enum": ["charger", "battery", "unknown"] }
      }
    },
    "software_version": { "type": "string", "minLength": 1 },
    "valid_from": { "$ref": "common.schema.json#/$defs/date" },
    "is_display_default": { "type": "boolean" },
    "notes": { "type": "string", "minLength": 1 }
  }
}
