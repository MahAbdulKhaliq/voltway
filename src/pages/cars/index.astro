---
// Cars tab (database-ui.md §4, B39): search, filters and sorts over every car, as cards or a
// table (the Browse island). Without JavaScript, a plain list of every car still links to them.
import Base from '../../layouts/Base.astro';
import Browse from '../../components/Browse.tsx';
import { t } from '../../i18n/t.ts';
import { loadIndex } from '../../lib/data.ts';

const index = loadIndex();
const byName = (a: string, b: string) => a.localeCompare(b, 'en', { sensitivity: 'base' });
const sorted = [...index].sort((a, b) => byName(a.make, b.make) || byName(a.model, b.model) || b.year - a.year || byName(a.name, b.name));
---

<Base title={t('cars.title')} active="cars">
  <h1>{t('cars.title')}</h1>
  <p class="muted">{t('cars.intro')}</p>
  <Browse client:load index={index} />
  <noscript>
    <p class="banner">{t('browse.noJs')}</p>
    <ul>
      {sorted.map((v) => <li><a href={`/charging?car=${v.id}`}>{v.year} {v.make} {v.model} {v.name}</a></li>)}
    </ul>
  </noscript>
</Base>
