---
// Page shell (B20): menu button (left) → side panel with a theme toggle, page search and the
// list of pages; then the logo; main content; footer. Trip joins
// PAGES as they're built. The map is the home page (B26). Distances render in km and are converted in place when the
// visitor picks miles (database-ui.md §9; the switch lives in the curve controls, B19).
// Archivo is bundled with the build and served from this site (no third-party font request, DESIGN-4).
import '@fontsource-variable/archivo/wght.css';
import '../styles/global.css';
import { t, type MessageKey } from '../i18n/t.ts';
import { COVERAGE } from '../config.ts';
import HeaderChips from '../components/HeaderChips.tsx';

type Page = 'map' | 'charging' | 'cars' | 'compare' | 'about';
// fill: the page is one full-screen tool (the map): no width limit and no footer; credits live in the tool.
interface Props { title?: string; description?: string; active?: Page; fill?: boolean }
const { title, description = t('site.tagline'), active, fill = false } = Astro.props;
const pageTitle = title ? `${title} · ${t('site.name')}` : t('site.name');
// Link preview (P.3): what LinkedIn, Slack and messaging apps show for a shared link.
// Links on the site have no trailing slash (/charging), so the canonical URL doesn't either.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isNotFound = path === '/404';
const pageUrl = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

// Pages in the menu. Search matches the name, the description and the keywords.
const PAGES: { id: Page; href: string }[] = [
  { id: 'map', href: '/' },
  { id: 'charging', href: '/charging' },
  { id: 'cars', href: '/cars' },
  { id: 'compare', href: '/compare' },
  { id: 'about', href: '/about' },
];
const page = (id: Page, part: 'name' | 'desc' | 'keywords') =>
  t((part === 'name' ? `nav.${id}` : `nav.${id}.${part}`) as MessageKey);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    {!isNotFound && <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!isNotFound && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.ogAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Apply a saved theme before first paint, so there is no flash of the wrong theme. -->
    <script is:inline>
      try {
        var saved = localStorage.getItem('voltway.theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class={fill ? "fill-page" : undefined}>
    <a class="skip" href="#main">{t('site.skip')}</a>
    <header class="site-header">
      <div class="wrap bar">
        <button type="button" class="icon-btn menu-btn" aria-haspopup="dialog" aria-controls="side-nav" aria-label={t('nav.menu')}>
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
        </button>
        <a class="logo" href="/">
          <!-- The mark: a yellow tile with the centre-line dashes (Road Paint). -->
          <svg class="logo-mark" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="6" fill="var(--paint)" /><path d="M12 4v4M12 10.5v3M12 16v4" stroke="var(--paint-ink)" stroke-width="2.5" stroke-linecap="butt" /></svg>
          <span>{t('site.name')}</span>
        </a>
        <HeaderChips client:idle showCompare />
      </div>
    </header>

    <dialog id="side-nav" class="side-nav" aria-label={t('nav.main')}>
      <div class="side-top">
        <button type="button" class="icon-btn theme-btn" data-light-label={t('theme.toLight')} data-dark-label={t('theme.toDark')} aria-label={t('theme.toDark')}>
          <svg class="i-moon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
          <svg class="i-sun" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
        <div class="units seg" role="group" aria-label={t('units.label')}>
          <button type="button" data-unit="km" aria-pressed="true">{t('units.km')}</button>
          <button type="button" data-unit="mi" aria-pressed="false">{t('units.mi')}</button>
        </div>
        <button type="button" class="icon-btn close-btn" aria-label={t('nav.close')}>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
      </div>
      <label class="search">
        <span class="sr-only">{t('nav.search')}</span>
        <input type="search" placeholder={t('nav.search')} autocomplete="off" aria-controls="page-list" />
      </label>
      <nav aria-label={t('nav.main')}>
        <ul id="page-list" class="page-list">
          {PAGES.map((p) => (
            <li data-search={`${page(p.id, 'name')} ${page(p.id, 'desc')} ${page(p.id, 'keywords')}`.toLowerCase()}>
              <a href={p.href} aria-current={active === p.id ? 'page' : undefined}>
                <span class="pl-name">{page(p.id, 'name')}</span>
                <span class="pl-desc">{page(p.id, 'desc')}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="no-match" role="status" hidden>{t('nav.noMatch')}</p>
      </nav>
    </dialog>

    <main id="main" class={fill ? 'fill' : 'wrap'}>
      <slot />
    </main>
    {!fill && <footer class="site-footer">
      <div class="wrap">
        <p>{t('scope.note', { market: COVERAGE.market, regulator: COVERAGE.regulator })}</p>
        <p>{t('footer.note')}</p>
        <p class="small">{t('footer.data')} <a href="/about#data">{t('footer.about')}</a></p>
      </div>
    </footer>}

    <script>
      import { applyUnits, currentUnit, setUnit } from '../scripts/units-client.ts';
      import { initBadges } from '../scripts/badges-client.ts';
      import { currentTheme, setTheme } from '../scripts/theme-client.ts';
      initBadges();
      applyUnits(currentUnit());
      document.querySelectorAll<HTMLButtonElement>('.units button').forEach((b) =>
        b.addEventListener('click', () => setUnit(b.dataset.unit === 'mi' ? 'mi' : 'km')),
      );

      // Side nav (B20): a modal <dialog>, so focus stays inside and Escape closes it.
      const nav = document.getElementById('side-nav') as HTMLDialogElement;
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
      const search = nav.querySelector<HTMLInputElement>('input[type=search]')!;
      const items = [...nav.querySelectorAll<HTMLLIElement>('.page-list li')];
      const noMatch = nav.querySelector<HTMLElement>('.no-match')!;
      const filter = () => {
        const words = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const li of items) {
          const hit = words.every((w) => (li.dataset.search ?? '').includes(w));
          li.hidden = !hit;
          if (hit) shown++;
        }
        noMatch.hidden = shown > 0;
      };
      menuBtn.addEventListener('click', () => { nav.showModal(); search.focus(); });
      nav.querySelector('.close-btn')!.addEventListener('click', () => nav.close());
      nav.addEventListener('click', (e) => { if (e.target === nav) nav.close(); }); // backdrop
      nav.addEventListener('close', () => { search.value = ''; filter(); menuBtn.focus(); });
      search.addEventListener('input', filter);
      search.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') nav.querySelector<HTMLAnchorElement>('.page-list li:not([hidden]) a')?.click();
      });

      // Theme toggle (B20): follows the device until the visitor picks, then remembers.
      const themeBtn = nav.querySelector<HTMLButtonElement>('.theme-btn')!;
      const syncThemeBtn = () => {
        const dark = currentTheme() === 'dark';
        themeBtn.setAttribute('aria-label', (dark ? themeBtn.dataset.lightLabel : themeBtn.dataset.darkLabel) ?? '');
        themeBtn.dataset.current = dark ? 'dark' : 'light';
      };
      themeBtn.addEventListener('click', () => { setTheme(currentTheme() === 'dark' ? 'light' : 'dark'); syncThemeBtn(); });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncThemeBtn);
      syncThemeBtn();
    </script>
  </body>
</html>

<style>
  .site-header { background: var(--bg); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 20; }
  .bar { display: flex; align-items: center; gap: 12px; min-height: 56px; }
  .logo { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; letter-spacing: -0.02em; text-decoration: none; color: var(--text); font-size: 1.15rem; white-space: nowrap; }
  .logo-mark { flex: none; }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex: none;
    border: 1px solid transparent; border-radius: 10px; background: transparent; color: var(--text); cursor: pointer;
  }
  .side-nav .icon-btn { border-color: var(--field-border); }
  .icon-btn:hover { background: var(--surface-2); }

  .side-nav {
    margin: 0; inset: 0 auto 0 0; height: 100dvh; max-height: 100dvh; width: min(320px, 86vw);
    padding: 16px; border: 0; border-right: 1px solid var(--border);
    background: var(--surface); color: var(--text); box-shadow: var(--shadow);
  }
  .side-nav[open] { display: flex; flex-direction: column; gap: 14px; animation: slide-in 0.18s ease-out; }
  .side-nav::backdrop { background: rgb(0 0 0 / 55%); }
  @keyframes slide-in { from { transform: translateX(-100%); } to { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .side-nav[open] { animation: none; } }
  .side-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .side-top .units { margin-left: auto; } /* km/mi for the whole site (B51) */
  .theme-btn .i-sun { display: none; }
  .theme-btn[data-current='dark'] .i-sun { display: block; }
  .theme-btn[data-current='dark'] .i-moon { display: none; }
  .search input {
    width: 100%; font: inherit; color: var(--text); background: var(--surface);
    border: 1px solid var(--field-border); border-radius: 10px; padding: 10px 12px;
  }
  .page-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .page-list li[hidden] { display: none; }
  .page-list a { display: grid; gap: 2px; padding: 10px 12px; border-radius: 10px; color: var(--text); text-decoration: none; }
  .page-list a:hover { background: var(--surface-2); }
  .page-list a[aria-current='page'] { background: var(--paint); color: var(--paint-ink); }
  .page-list a[aria-current='page'] .pl-desc { color: var(--paint-ink); }
  .pl-name { font-weight: 700; }
  .pl-desc { font-size: 0.85rem; color: var(--muted); }
  .no-match { color: var(--muted); margin: 0 12px; }
  .site-footer { border-top: 1px solid var(--border); color: var(--muted); padding: 20px 0 32px; font-size: 0.9rem; }
</style>
