---
// Page shell: header (logo + hamburger menu of pages, B19; Compare, My car, Map and Trip join the menu as they're built),
// main content and footer. Distances render in km and are converted in place by the
// small script below when the visitor picks miles (database-ui.md §9).
import '../styles/global.css';
import { t } from '../i18n/t.ts';
import { COVERAGE } from '../config.ts';

interface Props { title?: string; description?: string; active?: 'charging' | 'cars' }
const { title, description = t('site.tagline'), active } = Astro.props;
const pageTitle = title ? `${title} · ${t('site.name')}` : t('site.name');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">{t('site.skip')}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href="/">⚡ {t('site.name')}</a>
        <nav class="menu" aria-label={t('nav.main')}>
          <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-menu" aria-label={t('nav.menu')} data-open-label={t('nav.close')} data-closed-label={t('nav.menu')}>
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
          </button>
          <ul id="site-menu" class="menu-list" hidden>
            <li><a href="/charging" aria-current={active === 'charging' ? 'page' : undefined}>{t('nav.charging')}</a></li>
            <li><a href="/cars" aria-current={active === 'cars' ? 'page' : undefined}>{t('nav.cars')}</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{t('scope.note', { market: COVERAGE.market, regulator: COVERAGE.regulator })}</p>
        <p>{t('footer.note')}</p>
        <p class="small">{t('footer.data')}</p>
      </div>
    </footer>

    <script>
      import { applyUnits, currentUnit, setUnit } from '../scripts/units-client.ts';
      import { initBadges } from '../scripts/badges-client.ts';
      initBadges();
      applyUnits(currentUnit());
      // km/mi buttons live in the page now (B19: in the curve controls); any .units button still works.
      document.querySelectorAll<HTMLButtonElement>('.units button').forEach((b) =>
        b.addEventListener('click', () => setUnit(b.dataset.unit === 'mi' ? 'mi' : 'km')),
      );

      // Hamburger menu (B19): opens a list of pages; closes on Escape, outside click or a link.
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const list = document.getElementById('site-menu');
      if (btn && list) {
        const setOpen = (open: boolean) => {
          list.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', (open ? btn.dataset.openLabel : btn.dataset.closedLabel) ?? '');
        };
        btn.addEventListener('click', () => {
          const open = list.hidden !== false; // hidden can also be "until-found"
          setOpen(open);
          if (open) list.querySelector<HTMLAnchorElement>('a')?.focus();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !list.hidden) { setOpen(false); btn.focus(); }
        });
        document.addEventListener('click', (e) => {
          if (!list.hidden && !(e.target as Element).closest('.menu')) setOpen(false);
        });
      }
    </script>
  </body>
</html>

<style>
  .site-header { background: var(--surface); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 20; }
  .bar { display: flex; align-items: center; gap: 20px; min-height: 56px; }
  .logo { font-weight: 700; text-decoration: none; color: var(--text); font-size: 1.1rem; }
  .menu { margin-left: auto; position: relative; }
  .menu-btn {
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px;
    border: 1px solid var(--border); border-radius: 10px; background: transparent; color: var(--text); cursor: pointer;
  }
  .menu-btn:hover, .menu-btn[aria-expanded='true'] { background: var(--surface-2); }
  .menu-list {
    position: absolute; right: 0; top: calc(100% + 8px); min-width: 200px; margin: 0; padding: 6px; list-style: none;
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow);
  }
  .menu-list[hidden] { display: none; }
  .menu-list a { display: block; padding: 10px 12px; border-radius: 8px; color: var(--text); text-decoration: none; font-weight: 500; }
  .menu-list a:hover { background: var(--surface-2); }
  .menu-list a[aria-current='page'] { color: var(--accent); background: var(--accent-soft); }
  .site-footer { border-top: 1px solid var(--border); color: var(--muted); padding: 20px 0 32px; font-size: 0.9rem; }
</style>
