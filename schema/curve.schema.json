{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MahAbdulKhaliq/voltway/schema/curve.schema.json",
  "title": "Charging curve",
  "description": "SoC → kW points for one variant under stated conditions (vehicle-data-model.md §5). Points must be sorted by SoC (checked by the validator). Template estimates are generated by the data build, not stored here. A stored estimated curve is one borrowed from a same-pack sibling (B16) and says so in based_on. File: data/curves/<make>/<model>/<year>/<variant>/<curve>.json",
  "type": "object",
  "required": [
    "id",
    "variant_id",
    "kind",
    "source_id",
    "points",
    "is_display_default"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+/[0-9]{4}/[a-z0-9-]+$"
    },
    "kind": {
      "description": "Measured or published; estimated only when borrowed from a same-pack sibling (B16).",
      "enum": [
        "tested",
        "community",
        "manufacturer",
        "estimated"
      ]
    },
    "based_on": {
      "description": "Borrowed curves only (B16): the sibling variant whose measured curve this copies, and why the packs match.",
      "type": "object",
      "required": [
        "variant_id",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "variant_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+/[0-9]{4}/[a-z0-9-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_id": {
      "$ref": "common.schema.json#/$defs/sourceId"
    },
    "low_confidence": {
      "type": "boolean"
    },
    "points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "soc_percent",
          "power_kw"
        ],
        "additionalProperties": false,
        "properties": {
          "soc_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "power_kw": {
            "type": "number",
            "minimum": 0,
            "maximum": 1500
          }
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preconditioned": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "battery_temp_c": {
          "type": "number"
        },
        "ambient_temp_c": {
          "type": "number"
        },
        "charger_kw": {
          "type": "number",
          "minimum": 0
        },
        "charger_max_voltage_v": {
          "type": "number",
          "minimum": 0
        },
        "measured_at": {
          "description": "Whether power was measured at the charger or at the battery (C9 import note).",
          "enum": [
            "charger",
            "battery",
            "unknown"
          ]
        }
      }
    },
    "software_version": {
      "type": "string",
      "minLength": 1
    },
    "valid_from": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "is_display_default": {
      "type": "boolean"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_note": {
      "description": "B95: a person checked this curve despite plausibility warnings (scripts/lib/curve-check.ts) and says why it stands. Without it, a warned curve is not chosen as the default.",
      "type": "string",
      "minLength": 1
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "estimated"
      }
    },
    "required": [
      "kind"
    ]
  },
  "then": {
    "required": [
      "based_on",
      "low_confidence"
    ],
    "properties": {
      "based_on": true,
      "low_confidence": {
        "const": true
      }
    }
  },
  "else": {
    "properties": {
      "based_on": false
    }
  }
}
